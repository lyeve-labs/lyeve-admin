# SvelteKit UI - local dev environment
# Vite dev server runs on :5173. The engine must be running on :3001 (admin) and :3002 (API)

# Public URL of the app (used by adapter-node in production, ignored by Vite dev server)
ORIGIN=http://localhost:5173

# Where server-side code reaches the engine. Unset in dev: the Vite proxy in
# vite.config.ts handles it, and these two point that proxy at an engine elsewhere.
#CORE_INTERNAL_URL=http://localhost:3001
# Where the API reference page sends /api/v1 calls. Dev falls back to
# PROXY_API_TARGET, then localhost:3002. A production server refuses to start
# without it, because that fallback is its own port in the image.
#CORE_API_INTERNAL_URL=http://localhost:3002
#PROXY_ADMIN_TARGET=http://localhost:3001
#PROXY_API_TARGET=http://localhost:3002

# Shared secret the console signs its engine requests with, at least 32
# characters, and the same value as ADMIN_CONSOLE_KEY on the engine. A signed
# request names the browser's address, so the engine's login limiter and
# device risk count each user instead of this server. Unset, nothing is signed.
#
# The engine trusts the address this server signs, and this server takes it
# from adapter-node's getClientAddress(). Behind a proxy that is only the
# browser's address when ADDRESS_HEADER=x-forwarded-for and XFF_DEPTH equals the
# number of proxies in front of this server (1 behind one proxy). A depth too
# large, or a header the proxy passes through from the client, lets a browser
# name its own address, and the engine then counts it wherever it asks.
#ADMIN_CONSOLE_KEY=
